FROM python:3.12-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/

WORKDIR /app

RUN sed -i 's|http://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g; s|http://security.debian.org/debian-security|https://mirrors.aliyun.com/debian-security|g' /etc/apt/sources.list.d/debian.sources

RUN addgroup --system app && adduser --system --ingroup app app

FROM base AS builder

COPY --from=ghcr.io/astral-sh/uv:0.10.0 /uv /bin/uv

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# 先安装依赖，利用 Docker 缓存减少重复构建时间。
COPY pyproject.toml uv.lock ./
RUN uv sync --no-dev --no-install-project --compile-bytecode

COPY feedmind ./feedmind
COPY aegra.json ./aegra.json
RUN uv sync --no-dev --compile-bytecode

FROM builder AS dev

RUN uv sync --compile-bytecode

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 2026

CMD ["aegra", "serve"]

FROM base AS final

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/.venv /app/.venv
COPY aegra.json ./
COPY feedmind ./feedmind

ENV PATH="/app/.venv/bin:$PATH"

EXPOSE 2026

USER app

CMD ["aegra", "serve"]
