{
  "$schema": "https://turbo.build/schema.json",
  "envMode": "loose",
  "globalEnv": ["APP_ENV", "DATABASE_PATH", "ENCRYPTION_KEY", "NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["API_HOST", "API_PORT"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "tsconfig.json"]
    },
    "lint": {
      "inputs": ["src/**/*.ts", "src/**/*.tsx", ".eslintrc*", "eslint.config*"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "test/**/*.ts", "vitest.config*"]
    },
    "db:init": {},
    "db:generate": {},
    "db:migrate": {},
    "db:reset": {}
  }
}
