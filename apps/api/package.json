{
  "name": "@feedmind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -b && node -e \"require('fs').cpSync('src/mastra/skills','dist/mastra/skills',{recursive:true})\"",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --pass-with-no-tests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/react": "^4.0.23",
    "@feedmind/contracts": "workspace:*",
    "@feedmind/crawler-core": "workspace:*",
    "@feedmind/db": "workspace:*",
    "@feedmind/env": "workspace:*",
    "@feedmind/shared": "workspace:*",
    "@feedmind/wiki-core": "workspace:*",
    "@hono/node-server": "^2.0.8",
    "@hono/zod-openapi": "^1.4.0",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@mastra/agent-browser": "^0.4.1",
    "@mastra/ai-sdk": "^1.6.1",
    "@mastra/core": "^1.50.1",
    "@mastra/hono": "^1.5.6",
    "@mastra/libsql": "^1.15.1",
    "@mastra/memory": "^1.22.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@scalar/hono-api-reference": "^0.11.3",
    "@tavily/core": "^0.7.3",
    "ai": "catalog:",
    "crypto-js": "^4.2.0",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "exa-js": "^2.13.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "hono": "^4.12.29",
    "pino": "^10.3.1",
    "tsx": "^4.22.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:"
  }
