{
  "name": "@feedmind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @feedmind/contracts --filter @feedmind/shared --filter @feedmind/db build && tsx watch src/server.ts",
    "build": "tsc -b",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@feedmind/contracts": "workspace:*",
    "@feedmind/crawler-core": "workspace:*",
    "@feedmind/db": "workspace:*",
    "@feedmind/shared": "workspace:*",
    "@feedmind/wiki-core": "workspace:*",
    "@hono/node-server": "^2.0.4",
    "drizzle-orm": "^0.45.2",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "hono": "^4.12.23",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
