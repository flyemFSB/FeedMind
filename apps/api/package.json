{
  "name": "@feedmind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "tsc -b && cp -r src/mastra/skills dist/mastra/skills",
    "start": "bun dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "@feedmind/contracts": "workspace:*",
    "@feedmind/crawler-core": "workspace:*",
    "@feedmind/db": "workspace:*",
    "@feedmind/shared": "workspace:*",
    "@feedmind/wiki-core": "workspace:*",
    "@mastra/ai-sdk": "^1.4.0",
    "@mastra/core": "^1.4.0",
    "@mastra/hono": "^1.4.0",
    "@mozilla/readability": "^0.6.0",
    "@tavily/core": "^0.7.3",
    "ai": "^6.0.200",
    "drizzle-orm": "^0.45.2",
    "exa-js": "^2.13.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "hono": "^4.12.23",
    "jsdom": "^29.1.1",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  }
}
