{
  "name": "@feedmind/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/server.ts",
    "build": "tsc -b && node -e \"require('fs').cpSync('src/mastra/skills','dist/mastra/skills',{recursive:true})\"",
    "start": "node dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --pass-with-no-tests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.4",
    "@ai-sdk/react": "4.0.10",
    "@feedmind/contracts": "workspace:*",
    "@feedmind/crawler-core": "workspace:*",
    "@feedmind/db": "workspace:*",
    "@feedmind/env": "workspace:*",
    "@feedmind/shared": "workspace:*",
    "@feedmind/wiki-core": "workspace:*",
    "@hono/node-server": "^2.0.5",
    "@hono/zod-openapi": "^1.4.0",
    "@larksuiteoapi/node-sdk": "^1.67.0",
    "@mastra/agent-browser": "^0.4.0",
    "@mastra/ai-sdk": "^1.6.1",
    "@mastra/core": "^1.48.0",
    "@mastra/hono": "^1.5.3",
    "@mastra/libsql": "^1.14.3",
    "@mastra/memory": "^1.21.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@scalar/hono-api-reference": "^0.11.3",
    "@tavily/core": "^0.7.3",
    "ai": "^7.0.9",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "exa-js": "^2.13.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "hono": "^4.12.23",
    "jsdom": "^29.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.4",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "typescript": "^6.0.3"
  }
}
