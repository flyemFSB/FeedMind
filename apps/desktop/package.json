  "dependencies": {
    "@feedmind/api": "workspace:*",
    "dotenv": "catalog:"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
