{
  "name": "@feedmind/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "dev": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:13790 electron .",
