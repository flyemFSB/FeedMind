{
  "name": "@feedmind/desktop",
  "version": "0.1.0",
  "description": "FeedMind 桌面应用",
  "author": "FeedMind Team",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node build.mjs",
    "dev": "electron .",
    "start": "electron .",
    "lint": "oxlint .",
    "typecheck": "tsc -b --builders 4 --pretty false",
    "dist": "electron-builder --config electron-builder.yml && node -e \"fs.rmSync('../../release/win-unpacked',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@remotion/bundler": "4.0.518",
    "@remotion/renderer": "4.0.518",
    "playwright-core": "^1.62.1",
    "remotion": "4.0.518"
  },
  "devDependencies": {
    "@feedmind/api": "workspace:*",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "oxlint": "catalog:",
    "pino-pretty": "^13.1.3",
    "typescript": "catalog:"
  }
}
