{
  "name": "@feedmind/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @feedmind/contracts build && next dev",
    "build": "node --max-old-space-size=12288 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@assistant-ui/core": "0.2.7",
    "@assistant-ui/react": "^0.14.5",
    "@assistant-ui/react-langgraph": "^0.14.0",
    "@assistant-ui/react-streamdown": "^0.3.0",
    "@base-ui/react": "^1.4.1",
    "@feedmind/contracts": "workspace:*",
    "@langchain/langgraph-sdk": "^1.8.0",
    "@lobehub/icons": "^5.6.0",
    "@streamdown/cjk": "^1.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
