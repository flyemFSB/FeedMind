{
  "name": "@feedmind/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @feedmind/contracts --filter @feedmind/shared build && langgraphjs dev --host 127.0.0.1 --port 2024",
    "build": "tsc -b",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@feedmind/contracts": "workspace:*",
    "@feedmind/shared": "workspace:*",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/openai": "^1.4.7",
    "duck-duck-scrape": "^2.2.7",
    "langchain": "^1.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
