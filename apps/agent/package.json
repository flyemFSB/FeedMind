{
  "name": "@feedmind/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @feedmind/contracts --filter @feedmind/shared build && langgraphjs dev --host 127.0.0.1 --port 2024",
    "build": "tsc -b",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@feedmind/contracts": "workspace:*",
    "@feedmind/shared": "workspace:*",
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.2",
    "@langchain/langgraph-checkpoint": "^1.0.3",
    "@langchain/openai": "^1.4.7",
    "@mozilla/readability": "^0.6.0",
    "@tavily/core": "^0.7.3",
    "exa-js": "^2.13.0",
    "jsdom": "^29.1.1",
    "langchain": "^1.4.2",
    "turndown": "^7.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.2.2",
    "@types/jsdom": "^28.0.3",
    "@types/turndown": "^5.0.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
