LANGSMITH_API_KEY=
AEGRA_PORT=2026
NEXT_PUBLIC_AEGRA_API_URL=http://localhost:2026
NEXT_PUBLIC_AEGRA_ASSISTANT_ID=feedmind
# 后端 API 密钥加密密钥（首次部署请设置一个固定值，否则已加密数据重启后无法解密）
ENCRYPTION_KEY=feedmind
# Tavily — 高质量搜索 API，需注册获取 Key: https://tavily.com
TAVILY_API_KEY=
# ── 观测：Aegra 内置 Langfuse 集成（OTEL） ──────────────────
# 设置 OTEL_TARGETS=LANGFUSE 即可启用，Aegra 会自动添加 langfuse.user.id / session.id / trace.name 等属性。
OTEL_TARGETS=LANGFUSE
OTEL_SERVICE_NAME=feedmind-agent
# Langfuse 凭证（https://cloud.langfuse.com 或自托管地址）
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
