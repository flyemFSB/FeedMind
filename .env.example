DATABASE_PATH=./data/feedmind.db
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_API_URL=http://localhost:8000
AGENT_API_URL=http://localhost:2024

# Production proxy SSRF protection:
# In remote deployments (NODE_ENV=production), localhost/private IP upstreams are blocked.
# Set ALLOW_LOCAL_UPSTREAM=true to run locally with NODE_ENV=production (Electron / local preview).
# ALLOW_LOCAL_UPSTREAM=false
VITE_FEEDMIND_ASSISTANT_ID=feedmind
VITE_FEEDMIND_MODEL=
FEEDMIND_MODEL=
FEEDMIND_TEMPERATURE=0.2

# Used to encrypt stored model API keys. Keep this stable after first use.
ENCRYPTION_KEY=feedmind

# LangSmith tracing for LangGraph Server. Enable only after setting a real LANGSMITH_API_KEY.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="FeedMind"
LANGCHAIN_CALLBACKS_BACKGROUND=true
