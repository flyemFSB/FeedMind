DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/feedmind
APP_ENV=development
BACKEND_API_URL=http://localhost:8000
AGENT_API_URL=http://localhost:2024
NEXT_PUBLIC_FEEDMIND_ASSISTANT_ID=feedmind

# Used to encrypt stored model API keys. Keep this stable after first use.
ENCRYPTION_KEY=feedmind

# LangSmith tracing for LangGraph Server.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-api-key>
LANGSMITH_PROJECT="FeedMind"
