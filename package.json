{
  "name": "feedmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "trustedDependencies": ["esbuild"],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run build:packages && concurrently -n api,web -c cyan,green \"bun run api:dev\" \"bun run web:dev\"",
    "build": "bun --filter '*' build",
    "build:packages": "bun --filter @feedmind/contracts build && bun --filter @feedmind/shared build && bun --filter @feedmind/db build && bun --filter @feedmind/crawler-core build && bun --filter @feedmind/wiki-core build",
    "lint": "bun --filter '*' lint",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "db:init": "bun --filter @feedmind/db db:init",
    "db:generate": "bun --filter @feedmind/db db:generate",
    "db:migrate": "bun --filter @feedmind/db db:migrate",
    "db:reset": "bun --filter @feedmind/db db:reset",
    "web:dev": "bun --filter @feedmind/web dev",
    "api:dev": "bun --filter @feedmind/api dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.1.0"
  }
}
