{
  "name": "feedmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run build:packages && concurrently -n api,web -c cyan,green \"pnpm run api:dev\" \"pnpm run web:dev\"",
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @feedmind/contracts build && pnpm --filter @feedmind/shared build && pnpm --filter @feedmind/db build && pnpm --filter @feedmind/crawler-core build && pnpm --filter @feedmind/wiki-core build && pnpm --filter @feedmind/env build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:init": "pnpm --filter @feedmind/db db:init",
    "db:generate": "pnpm --filter @feedmind/db db:generate",
    "db:migrate": "pnpm --filter @feedmind/db db:migrate",
    "db:reset": "pnpm --filter @feedmind/db db:reset",
    "web:dev": "pnpm --filter @feedmind/web dev",
    "api:dev": "pnpm --filter @feedmind/api dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.6.2",
    "typescript": "catalog:",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
