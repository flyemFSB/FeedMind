{
  "name": "feedmind",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "pnpm run build:packages && concurrently -n api,web -c cyan,green \"pnpm run api:dev\" \"pnpm run web:dev\"",
    "dev": "pnpm run build:packages && concurrently -n api,web -c cyan,green \"pnpm run api:dev\" \"pnpm run web:dev\"",
    "build": "pnpm -r run build",
    "build:packages": "pnpm --filter @feedmind/contracts --filter @feedmind/shared --filter @feedmind/db --filter @feedmind/crawler-core --filter @feedmind/wiki-core run build",
    "lint": "pnpm -r run lint",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "db:init": "pnpm --filter @feedmind/db run db:init",
    "db:generate": "pnpm --filter @feedmind/db run db:generate",
    "db:migrate": "pnpm --filter @feedmind/db run db:migrate",
    "db:reset": "pnpm --filter @feedmind/db run db:reset",
    "web:dev": "pnpm --filter @feedmind/web run dev",
    "api:dev": "pnpm --filter @feedmind/api run dev",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "concurrently": "^9.1.2",
    "eslint": "^10.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^3.1.3",
    "zod": "3.25.28"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
