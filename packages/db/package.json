{
  "name": "@feedmind/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src drizzle.config.ts --ext .ts",
    "test": "vitest run --pass-with-no-tests",
    "typecheck": "tsc -b --pretty false",
    "db:push": "drizzle-kit push",
    "db:init": "tsx src/init.ts",
    "db:reset": "tsx src/reset.ts"
  },
  "dependencies": {
    "@feedmind/shared": "workspace:*",
    "@libsql/client": "^0.17.3",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.6",
    "typescript": "catalog:"
  }
}
