# ==============================================================================
# FeedMind .gitignore
# ==============================================================================

# 1. 依赖管理
node_modules/
.pnpm-store/
package-lock.json
yarn.lock

# 2. 环境变量与敏感凭据
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 3. 构建产物与打包输出
dist/
dist-electron/
build/
out/
release/
release-builds/
*.exe
*.zip
*.asar
*.asar.unpacked
builder-effective-config.yaml
builder-debug.yml
*.tsbuildinfo
.tsbuildinfo/
.turbo/
.vercel/
.next/

# 4. 测试与覆盖率产物
coverage/
htmlcov/
.coverage
test-results/
playwright-report/
blob-report/
.playwright/
.playwright-mcp/
.vitest/

# 5. 运行时数据与本地存储
data/
logs/
*.log
*.sqlite*
*.db*
.mastra/
drizzle/
raw/
.feedmind/
**/raw/
**/.feedmind/

# 6. 本地文档与临时文件
docs/
tmp/
temp/
_tmp_*
*.tmp
.scratch/
.cache/
.venv/
__pycache__/
*.py[cod]

# 7. 操作系统与 IDE / AI 辅助工具
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
*.swp
*.swo
*.swn
*.bak
.idea/
.vscode/
.cursor/
.gemini/
.antigravity/
.claude/
.impeccable/
