# ==============================================================================
# FeedMind .gitignore
# 知识管理、AI 对话、内容爬取服务平台
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 环境变量与敏感凭据 (Environment & Secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. 依赖管理与包管理器 (Dependencies & Package Managers)
# ------------------------------------------------------------------------------
node_modules/
.pnpm-store/
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. 构建与编译产物 (Build Outputs & Release)
# ------------------------------------------------------------------------------
dist/
dist-electron/
build/
out/
release/
release-builds/
*.exe
*.zip
*.asar
*.asar.unpacked
builder-effective-config.yaml
builder-debug.yml
*.tsbuildinfo
.tsbuildinfo/
.turbo/
.vercel/
.next/

# ------------------------------------------------------------------------------
# 4. 测试与覆盖率产物 (Test & Coverage Artifacts)
# ------------------------------------------------------------------------------
coverage/
htmlcov/
.coverage
.pytest_cache/
pytest-cache-files-*/
test-results/
playwright-report/
blob-report/
.playwright/
.playwright-mcp/
.vitest/

# ------------------------------------------------------------------------------
# 5. 运行时数据与数据库 (Runtime Data & Databases)
# ------------------------------------------------------------------------------
data/
logs/
*.log
*.sqlite*
*.db*
.mastra/
drizzle/
raw/
.feedmind/
**/raw/
**/.feedmind/

# ------------------------------------------------------------------------------
# 6. 本地文档（不入库；ADR / 调研草稿仅保留在本机）
# ------------------------------------------------------------------------------
docs/

# ------------------------------------------------------------------------------
# 7. 本地临时与缓存文件 (Temp & Cache Files)
# ------------------------------------------------------------------------------
tmp/
temp/
_tmp_*
*.tmp
.scratch/
.cache/
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 8. 操作系统与编辑器/IDE (OS & IDEs / AI Assistants)
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# 编辑器临时与备份
*~
*.swp
*.swo
*.swn
*.bak

# IDE & AI 工具
.idea/
.vscode/
.cursor/
.gemini/
.antigravity/
.impeccable/
.qoder/
.pi-subagents/

# Claude Code: 保留团队共享 settings.json，仅忽略本地个人配置
.claude/settings.local.json
.claude/mcp.local.json

# Husky 内部生成目录
.husky/_/
